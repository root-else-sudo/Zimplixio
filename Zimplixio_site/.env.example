# =============================================================================
# Zimplixio — Environment Variables Reference
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# `.env` is gitignored — never commit real secrets.
#
# HOW DEV / PROD SWITCHING WORKS
# ─────────────────────────────────────────────────────────────────────────────
# The DJANGO_SETTINGS_MODULE key controls which settings file Django loads:
#
#   Local dev  → Zimplixio_site.settings.dev   (DEBUG=True, console email)
#   Production → Zimplixio_site.settings.prod  (DEBUG=False, HSTS, SSL)
#
# Locally:  set DJANGO_SETTINGS_MODULE=Zimplixio_site.settings.dev in .env
# Railway:  set DJANGO_SETTINGS_MODULE=Zimplixio_site.settings.prod
#           in the Railway dashboard under Variables — no .env file on server.
# =============================================================================


# ── Django core ───────────────────────────────────────────────────────────────

# Controls which settings module is loaded (see note above)
DJANGO_SETTINGS_MODULE=Zimplixio_site.settings.dev

# Generate a fresh secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Dev: any string works. Prod: must be long, random, and never reused.
SECRET_KEY=your-secret-key-here

# Dev: True. Prod: always False (prod.py already enforces this — but set it anyway).
DEBUG=True

# Comma-separated list of allowed hostnames.
# Dev: localhost,127.0.0.1
# Prod: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ── Database ──────────────────────────────────────────────────────────────────

# Dev: local PostgreSQL instance.
# Prod: Railway provides this automatically as DATABASE_URL in its dashboard.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Note: special characters in the password must be URL-encoded (e.g. $ → %24)
DATABASE_URL=postgres://postgres:your-db-password@localhost:5432/zimplixio_site


# ── Anthropic API ─────────────────────────────────────────────────────────────

# Required for the AI readiness assessment (/showcase/ai-adoption-framework/).
# Returns 503 if empty. Get your key at console.anthropic.com.
# Rotate this key before going to production if it was ever used locally.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here


# ── Email ─────────────────────────────────────────────────────────────────────

# Dev: use console backend — emails print to the terminal, nothing is sent.
# Prod: switch to SMTP and fill in the credentials below.
#
# Dev backend:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Prod backend:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Prod: use a Gmail App Password (not your account password).
# Generate one at myaccount.google.com → Security → App passwords.
EMAIL_HOST_USER=your-sending-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

DEFAULT_FROM_EMAIL=noreply@zimplixio.com


# ── Business settings ─────────────────────────────────────────────────────────

# Recipient for lead notification emails (AI assessment form submissions).
LEAD_NOTIFICATION_EMAIL=joe.ugalde@zimplixio.com

# Zoom meeting link included in booking confirmation emails sent to visitors.
# Kept out of version control — contains meeting ID and password.
ZOOM_MEETING_URL=https://us05web.zoom.us/j/your-meeting-id?pwd=your-password
